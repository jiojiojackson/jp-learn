{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker 名称：在 Cloudflare 控制台连接 GitHub 时，Worker 名必须与此处一致
  "name": "jp-learn",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // D1：不写 database_id，首次 `wrangler deploy` 时会自动创建并绑定（需要 wrangler >= 4.45）
  // 如果想用已有数据库，改成：
  // { "binding": "DB", "database_name": "jp-learn-db", "database_id": "<你的 D1 数据库 ID>" }
  "d1_databases": [{ "binding": "DB" }],
  "observability": { "enabled": true }
}
